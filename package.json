{
	"name": "fintrack-be",
	"version": "1.0.1",
	"type": "module",
	"description": "FinTrack backend API",
	"author": "Abishek Bardewa",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"main": "dist/server.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"dev:staging": "NODE_ENV=staging tsx watch src/server.ts",
		"dev:debug": "NODE_ENV=development tsx --inspect-brk src/server.ts",
		"build": "tsc",
		"start": "NODE_ENV=production node dist/server.js",
		"start:dev": "NODE_ENV=development node dist/server.js",
		"start:staging": "NODE_ENV=staging node dist/server.js",
		"typecheck": "tsc --noEmit",
		"openapi:export": "tsx src/openapi/export-openapi.ts"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^7.3.4",
		"@types/bcrypt": "^5.0.2",
		"@types/cors": "^2.8.17",
		"@types/exceljs": "^0.5.3",
		"@types/express": "^4.17.21",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/node": "^22.10.0",
		"@types/swagger-ui-express": "^4.1.8",
		"@vercel/blob": "^2.8.0",
		"bcrypt": "^5.1.1",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"exceljs": "^4.4.0",
		"express": "^4.21.1",
		"express-mongo-sanitize": "^2.2.0",
		"express-rate-limit": "^7.4.1",
		"helmet": "^8.0.0",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^8.7.1",
		"multer": "^2.2.0",
		"node-cron": "^4.6.0",
		"sharp": "^0.35.3",
		"swagger-ui-express": "^5.0.1",
		"typescript": "^5.7.2",
		"winston": "^3.15.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/multer": "^2.2.0",
		"tsx": "^4.19.2"
	}
}
