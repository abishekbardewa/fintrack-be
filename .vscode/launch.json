{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Debug API (development)",
			"runtimeExecutable": "node",
			"runtimeArgs": ["--import", "tsx"],
			"args": ["${workspaceFolder}/src/server.ts"],
			"cwd": "${workspaceFolder}",
			"env": {
				"NODE_ENV": "development"
			},
			"envFile": "${workspaceFolder}/.env.development",
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"],
			"sourceMaps": true
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Debug API (staging)",
			"runtimeExecutable": "node",
			"runtimeArgs": ["--import", "tsx"],
			"args": ["${workspaceFolder}/src/server.ts"],
			"cwd": "${workspaceFolder}",
			"env": {
				"NODE_ENV": "staging"
			},
			"envFile": "${workspaceFolder}/.env.staging",
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"],
			"sourceMaps": true
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Debug API (break on start)",
			"runtimeExecutable": "node",
			"runtimeArgs": ["--import", "tsx", "--inspect-brk"],
			"args": ["${workspaceFolder}/src/server.ts"],
			"cwd": "${workspaceFolder}",
			"env": {
				"NODE_ENV": "development"
			},
			"envFile": "${workspaceFolder}/.env.development",
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"],
			"sourceMaps": true
		},
		{
			"type": "node",
			"request": "attach",
			"name": "Attach to API",
			"port": 9229,
			"restart": true,
			"cwd": "${workspaceFolder}",
			"skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"],
			"sourceMaps": true
		}
	]
}
